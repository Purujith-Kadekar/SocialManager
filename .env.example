# ====================================
# SocialManager API - Environment Variables
# ====================================
# Copy this file to .env.local and fill in your values.
# Deploy the same keys to Vercel → Project → Settings → Environment Variables.

# --- Supabase Project ---
# Used ONLY by the recipe data layer (read/write to the `recipes` table and
# the `recipe-packages` storage bucket). Admin auth does NOT use Supabase.
# Get these from: https://app.supabase.com/project/<your-project>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_STORAGE_BUCKET=recipe-packages

# --- Admin Auth (HTTP Basic Auth, env-based) ---
# /admin/* and /api/admin/* are protected by HTTP Basic Auth.
# The browser shows its native login dialog on first visit — no login page.
# Set these to whatever you want your admin credentials to be.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-this-to-a-strong-password
