# ====================================
# SocialManager API - Environment Variables
# ====================================
# Copy this file to .env.local and fill in your values.
# See MIGRATION.md for setup instructions.

# --- Supabase Project ---
# Get these from: https://app.supabase.com/project/<your-project>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only keys (NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- Auth ---
# A random 32+ char string used to sign JWTs. Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-random-32-char-string

# --- Admin Access ---
# Comma-separated list of emails that can access /admin
# Example: SUPABASE_ADMIN_EMAILS=you@example.com,friend@example.com
SUPABASE_ADMIN_EMAILS=your-email@example.com

# --- Google OAuth (optional) ---
# Get these from: https://console.cloud.google.com/apis/credentials
# Set authorized redirect URI to: https://your-app.vercel.app/api/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- App Config ---
# Public URL of your deployed app (used for auth redirects, CORS)
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# --- Storage Bucket Name ---
# Must match the bucket you create in Supabase Storage
SUPABASE_STORAGE_BUCKET=recipe-packages
