# ====================================
# SocialManager API - Environment Variables
# ====================================
# Copy this file to .env.local and fill in your values.
# Deploy the same keys to Vercel → Project → Settings → Environment Variables.

# --- Supabase Project ---
# Used ONLY by the recipe data layer (read/write to the `recipes` table and
# the `recipe-packages` storage bucket). The admin LOGIN does NOT use
# Supabase Auth — admin identity is env-based (see below).
# Get these from: https://app.supabase.com/project/<your-project>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_STORAGE_BUCKET=recipe-packages

# --- Admin Login (env-based, NOT Supabase Auth) ---
# The /login page compares the submitted email+password against these.
# Set them to whatever you want your admin credentials to be.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-this-to-a-strong-password

# --- Session signing secret ---
# Random 32+ character string used to HMAC-sign the admin session cookie.
# Generate with:  openssl rand -base64 32
AUTH_SECRET=replace-with-random-32-char-string
