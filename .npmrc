# Use legacy peer deps handling — React 19 has peer dep conflicts with
# several older packages (next-auth@4, etc.) that haven't shipped React 19
# support yet. Without this, `npm install` on Vercel fails with ERESOLVE.
legacy-peer-deps=true

# Make npm fetch from the public registry (avoids weird proxy issues on Vercel).
registry=https://registry.npmjs.org/
